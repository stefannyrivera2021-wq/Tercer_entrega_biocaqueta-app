<section class="section" aria-labelledby="editar-title">
  <a class="back-link" href="/#consulta">← Volver a los avistamientos</a>
  <h1 class="section-title" id="editar-title">Editar avistamiento</h1>

  <div class="species-summary">
    <div>
      <strong>{{avistamiento.nombreComun}}</strong>
      <em>{{avistamiento.nombreCientifico}}</em>
    </div>
    <dl>
      <div><dt>Categoría</dt><dd>{{avistamiento.categoria}}</dd></div>
      <div><dt>Investigador</dt><dd>{{avistamiento.investigador}}</dd></div>
      <div><dt>Registrado</dt><dd>{{avistamiento.fechaVisible}}</dd></div>
    </dl>
  </div>

  <form action="/api/avistamientos/update/{{avistamiento.id}}" method="POST" class="form-grid">
    <div class="field">
      <label for="zona">Zona <span class="req">*</span></label>
      <input id="zona" name="zona" value="{{avistamiento.zona}}" list="zonas-sugeridas" autocomplete="off" required>
      <datalist id="zonas-sugeridas">
        {{#each zonas}}<option value="{{this}}"></option>{{/each}}
      </datalist>
    </div>
    <div class="field">
      <label for="estadoConservacion">Estado de conservación <span class="req">*</span></label>
      <select id="estadoConservacion" name="estadoConservacion" required>
        {{#each estados}}<option value="{{valor}}" {{#if seleccionado}}selected{{/if}}>{{valor}}</option>{{/each}}
      </select>
    </div>
    <div class="form-actions">
      <button class="btn btn-primary" type="submit">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h11l4 4v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a1 1 0 0 1 1-2z"/><path d="M8 3v5h7V3"/><rect x="7" y="13" width="10" height="8" rx="1"/></svg>
        Guardar cambios
      </button>
      <a class="btn btn-ghost" href="/#consulta">Cancelar</a>
    </div>
  </form>
</section>
