<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&family=Source+Serif+4:opsz,wght@8..60,700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v=4">
</head>
<body>
  <div class="shell">
    <aside class="cover" role="img" aria-label="Cuaderno de campo · Piedemonte amazónico, Caquetá"></aside>

    <div class="page">
      <header class="topbar">
        <a href="/" class="brand">
          <svg class="brand-leaf" viewBox="0 0 40 40" aria-hidden="true">
            <path d="M19 36C18 26 13 19 4 15c9-1 16 4 17 13" />
            <path d="M21 36c-1-11 4-21 15-28-2 12-6 20-14 24" />
          </svg>
          BioCaquetá
        </a>
        <nav class="nav-links" aria-label="Principal">
          <a href="/#registro" data-nav="registro">Registrar</a>
          <a href="/#consulta" data-nav="consulta">Consultar</a>
        </nav>
      </header>

      <main class="content">
        {{{body}}}
      </main>

      <footer class="footer">Sistema de Monitoreo de Biodiversidad · Universidad de la Amazonia · Florencia, Caquetá</footer>
    </div>
  </div>

  <script>
    // Marca en la barra superior la sección que se está viendo
    (() => {
      const links = document.querySelectorAll('[data-nav]');
      const marcar = (id) => links.forEach((l) => l.classList.toggle('is-active', l.dataset.nav === id));
      const secciones = ['registro', 'consulta'].map((id) => document.getElementById(id)).filter(Boolean);
      if (!secciones.length) { marcar(location.pathname.startsWith('/editar') ? 'consulta' : 'registro'); return; }
      marcar('registro');
      const obs = new IntersectionObserver((entradas) => {
        entradas.forEach((e) => { if (e.isIntersecting) marcar(e.target.id); });
      }, { rootMargin: '-40% 0px -55% 0px' });
      secciones.forEach((s) => obs.observe(s));
    })();
  </script>
</body>
</html>
